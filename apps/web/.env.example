# Where the "Start free trial" buttons send people (the Stayflow Profit app).
NEXT_PUBLIC_PROFIT_URL=http://localhost:3001

# Shop assistant (free-text chat). Server-only: NEVER prefix these with NEXT_PUBLIC_.
# Without ANTHROPIC_API_KEY the assistant still works in its guided, rule-based mode.
# Set a spend limit for this key in the AI provider's console: it is the hard cap; the limits below are only a brake.
ANTHROPIC_API_KEY=
# Default is a small, low-cost model. Change it here if you prefer a more capable one (it costs more per conversation).
ASSISTANT_MODEL=claude-haiku-5-5
# Switch the AI chat off without touching the code (the guided mode keeps working).
ASSISTANT_ENABLED=true
# Messages per visitor per 10 minutes, and per day for the whole site (per server instance).
ASSISTANT_PER_10_MIN=20
ASSISTANT_DAILY_LIMIT=400

# Host launch price (USD 38). Ends by itself at this moment; leave empty to use the default (2026-11-30T23:59:00-03:00) or write "off" to switch it off.
NEXT_PUBLIC_HOST_LAUNCH_ENDS_AT=
