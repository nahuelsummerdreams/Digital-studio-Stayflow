{
  "name": "stayflow",
  "private": true,
  "version": "0.1.0",
  "description": "Stayflow by Digital Studio: modular tools for vacation rental hosts.",
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev:profit": "pnpm --filter @stayflow/app-profit dev",
    "dev:web": "pnpm --filter @stayflow/web dev",
    "dev:guest": "pnpm --filter @stayflow/app-guest dev",
    "dev:host": "pnpm --filter @stayflow/app-host dev",
    "dev:operations": "pnpm --filter @stayflow/app-operations dev",
    "build": "pnpm -r build",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck"
  }
}
